lutions\']),\n        \'qa2_status\': data[\'qa2_status\']\n    })\n\nobservations.sort(key=lambda x: x[\'member_ous_uid\'])\n\n# Compute summary statistics\nall_bands = set()\nfor obs in observations:\n    all_bands.update(obs[\'band\'])\nall_bands = sorted(all_bands)\n\nall_res = [obs[\'best_spatial_resolution_arcsec\'] for obs in observations]\nmin_res = min(all_res)\nmax_res = max(all_res)\n\nband6_count = sum(1 for obs in observations if 6 in obs[\'band\'])\nband7_count = sum(1 for obs in observations if 7 in obs[\'band\'])\n\nsummary = (\n    f"A total of {len(observations)} unique ALMA Member Observation Unit Sets (MOUS) "\n    f"targeting HH 212 were found in Band 6 and/or Band 7 with spatial resolution better than 1 arcsecond. "\n    f"Of these, {band6_count} include Band 6 data and {band7_count} include Band 7 data. "\n    f"The best spatial resolution achieved ranges from {min_res:.4f} to {max_res:.4f} arcsec across the sample, "\n    f"reflecting a range of ALMA configurations from moderate to very high angular resolution. "\n    f"These public, science-grade observations span multiple ALMA projects and provide a rich dataset for studying "\n    f"the HH 212 protostellar outflow system at sub-arcsecond scales."\n)\n\noutput = {\n    \'target_name\': \'HH 212\',\n    \'resolved_ra_deg\': ra,\n    \'resolved_dec_deg\': dec,\n    \'search_radius_arcsec\': radius_arcsec,\n    \'band_filter\': [6, 7],\n    \'max_spatial_resolution_arcsec\': 1.0,\n    \'num_observations\': len(observations),\n    \'observations\': observations,\n    \'summary\': summary\n}\n\nwith open(\'/app/output.json\', \'w\') as f:\n    json.dump(output, f, indent=2)\n\nprint(f"Wrote output.json with {len(observations)} observations")\nprint(json.dumps(output, indent=2)[:2000])\nPYEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
