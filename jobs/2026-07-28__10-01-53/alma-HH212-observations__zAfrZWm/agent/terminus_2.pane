[?2004hroot@f1b01bdb67bf:/app# cat << 'PYEOF' > /app/query.py
[?2004l[?2004h> from astroquery.alma import Alma
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> alma = Alma()
[?2004l[?2004h> ra, dec = 85.96420833333333, -1.0480833333333335
[?2004l[?2004h> radius_arcsec = 30.0
[?2004l[?2004h> 
[?2004l[?2004h> query = f"""
[?2004l[?2004h> SELECT target_name, s_ra, s_dec, member_ous_uid, proposal_id, band_list,
[?2004l[?2004h>        spatial_resolution, qa2_passed, science_observation, data_rights
[?2004l[?2004h> FROM ivoa.obscore
[?2004l[?2004h> WHERE CONTAINS(POINT('ICRS', s_ra, s_dec), CIRCLE('ICRS', {ra}, {dec}, {radius_arcsec/3600.0})) = 1
[?2004l[?2004h> AND science_observation = 'T'
[?2004l[?2004h> AND data_rights = 'Public'
[?2004l[?2004h> """
[?2004l[?2004h> 
[?2004l[?2004h> result = alma.query_tap(query)
[?2004l[?2004h> tab = result.to_table()
[?2004l[?2004h> print(f"Total rows before band/resolution filter: {len(tab)}")
[?2004l[?2004h> 
[?2004l[?2004h> # Filter by band 6 or 7
[?2004l[?2004h> band_mask = np.isin(tab['band_list'], ['6', '7'])
[?2004l[?2004h> tab_band = tab[band_mask]
[?2004l[?2004h> print(f"Rows after band filter: {len(tab_band)}")
[?2004l[?2004h> 
[?2004l[?2004h> # Filter by spatial_resolution < 1.0
[?2004l[?2004h> res_mask = tab_band['spatial_resolution'] < 1.0
[?2004l[?2004h> tab_filt = tab_band[res_mask]
[?2004l[?2004h> print(f"Rows after resolution filter: {len(tab_filt)}")
[?2004l[?2004h> 
[?2004l[?2004h> # Group by member_ous_uid
[?2004l[?2004h> mous_groups = {}
[?2004l[?2004h> for row in tab_filt:
[?2004l[?2004h>     mous = str(row['member_ous_uid'])
[?2004l[?2004h>     if mous not in mous_groups:
[?2004l[?2004h>         mous_groups[mous] = {
[?2004l[?2004h>             'member_ous_uid': mous,
[?2004l[?2004h>             'project_code': str(row['proposal_id']),
[?2004l[?2004h>             'alma_source_name': str(row['target_name']),
[?2004l[?2004h>             'ra_deg': float(row['s_ra']),
[?2004l[?2004h>             'dec_deg': float(row['s_dec']),
[?2004l[?2004h>             'bands': set(),
[?2004l[?2004h>             'resolutions': [],
[?2004l[?2004h>             'qa2_status': str(row['qa2_passed'])
[?2004l[?2004h>         }
[?2004l[?2004h>     mous_groups[mous]['bands'].add(int(row['band_list']))
[?2004l[?2004h>     mous_groups[mous]['resolutions'].append(float(row['spatial_resolution']))
[?2004l[?2004h> 
[?2004l[?2004h> observations = []
[?2004l[?2004h> for mous, data in mous_groups.items():
[?2004l[?2004h>     observations.append({
[?2004l[?2004h>         'member_ous_uid': data['member_ous_uid'],
[?2004l[?2004h>         'project_code': data['project_code'],
[?2004l[?2004h>         'alma_source_name': data['alma_source_name'],
[?2004l[?2004h>         'ra_deg': data['ra_deg'],
[?2004l[?2004h>         'dec_deg': data['dec_deg'],
[?2004l[?2004h>         'band': sorted(data['bands']),
[?2004l[?2004h>         'best_spatial_resolution_arcsec': min(data['resolutions']),
[?2004l[?2004h>         'qa2_status': data['qa2_status']
[?2004l[?2004h>     })
[?2004l[?2004h> 
[?2004l[?2004h> # Sort by project_code for consistency
[?2004l[?2004h> observations.sort(key=lambda x: x['member_ous_uid'])
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Number of unique MOUS: {len(observations)}")
[?2004l[?2004h> for obs in observations:
[?2004l[?2004h>     print(obs)
[?2004l[?2004h> 
[?2004l[?2004h> # Save intermediate for building final output
[?2004l[?2004h> with open('/app/observations_temp.json', 'w') as f:
[?2004l[?2004h>     json.dump(observations, f, indent=2)
[?2004l[?2004h> PYEOF
