[165.502445, "i", "cat << 'PYEOF' > /app/query.py\nfrom astroquery.alma import Alma\nimport numpy as np\nimport json\n\nalma = Alma()\nra, dec = 85.96420833333333, -1.0480833333333335\nradius_arcsec = 30.0\n\nquery = f\"\"\"\nSELECT target_name, s_ra, s_dec, member_ous_uid, proposal_id, band_list,\n       spatial_resolution, qa2_passed, science_observation, data_rights\nFROM ivoa.obscore\nWHERE CONTAINS(POINT('ICRS', s_ra, s_dec), CIRCLE('ICRS', {ra}, {dec}, {radius_arcsec/3600.0})) = 1\nAND science_observation = 'T'\nAND data_rights = 'Public'\n\"\"\"\n\nresult = alma.query_tap(query)\ntab = result.to_table()\nprint(f\"Total rows before band/resolution filter: {len(tab)}\")\n\n# Filter by band 6 or 7\nband_mask = np.isin(tab['band_list'], ['6', '7'])\ntab_band = tab[band_mask]\nprint(f\"Rows after band filter: {len(tab_band)}\")\n\n# Filter by spatial_resolution < 1.0\nres_mask = tab_band['spatial_resolution'] < 1.0\ntab_filt = tab_band[res_mask]\nprint(f\"Rows after resolution filter: {len(tab_filt)}\")\n\n# Group by member_ous_uid\nmous_groups = {}\nfor row in tab_filt:\n    mous = str(row['member_ous_uid'])\n    if mous not in mous_groups:\n        mous_groups[mous] = {\n            'member_ous_uid': mous,\n            'project_code': str(row['proposal_id']),\n            'alma_source_name': str(row['target_name']),\n            'ra_deg': float(row['s_ra']),\n            'dec_deg': float(row['s_dec']),\n            'bands': set(),\n            'resolutions': [],\n            'qa2_status': str(row['qa2_passed'])\n        }\n    mous_groups[mous]['bands'].add(int(row['band_list']))\n    mous_groups[mous]['resolutions'].append(float(row['spatial_resolution']))\n\nobservations = []\nfor mous, data in mous_groups.items():\n    observations.append({\n        'member_ous_uid': data['member_ous_uid'],\n        'project_code': data['project_code'],\n        'alma_source_name': data['alma_source_name'],\n        'ra_deg': data['ra_deg'],\n        'dec_deg': data['dec_deg'],\n        'band': sorted(data['bands']),\n        'best_spatial_resolution_arcsec': min(data['resolutions']),\n        'qa2_status': data['qa2_status']\n    })\n\n# Sort by project_code for consistency\nobservations.sort(key=lambda x: x['member_ous_uid'])\n\nprint(f\"Number of unique MOUS: {len(observations)}\")\nfor obs in observations:\n    print(obs)\n\n# Save intermediate for building final output\nwith open('/app/observations_temp.json', 'w') as f:\n    json.dump(observations, f, indent=2)\nPYEOF\n"]
[165.502646, "o", "cat << 'PYEOF' > /app/query.py\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.502852, "o", "from astroquery.alma import Alma\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> alma = Alma()\r\n\u001b[?2004l\r\u001b[?2004h> ra, dec = 85.96420833333333, -1.0480833333333335\r\n\u001b[?2004l\r\u001b[?2004h> radius_arcsec = 30.0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> query = f\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.502969, "o", "SELECT target_name, s_ra, s_dec, member_ous_uid, proposal_id, band_list,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.503008, "o", "       spatial_resolution, qa2_passed, science_observation, data_rights\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.50316, "o", "FROM ivoa.obscore\r\n\u001b[?2004l\r\u001b[?2004h> WHERE CONTAINS(POINT('ICRS', s_ra, s_dec), CIRCLE('ICRS', {ra}, {dec}, {radius_arcsec/3600.0})) = 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.503239, "o", "AND science_observation = 'T'\r\n\u001b[?2004l\r\u001b[?2004h> AND data_rights = 'Public'\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[165.503399, "o", "\u001b[?2004h> result = alma.query_tap(query)\r\n\u001b[?2004l\r\u001b[?2004h> tab = result.to_table()\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Total rows before band/resolution filter: {len(tab)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Filter by band 6 or 7\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.503767, "o", "band_mask = np.isin(tab['band_list'], ['6', '7'])\r\n\u001b[?2004l\r\u001b[?2004h> tab_band = tab[band_mask]\r\n\u001b[?2004l\r"]
[165.503809, "o", "\u001b[?2004h> print(f\"Rows after band filter: {len(tab_band)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Filter by spatial_resolution < 1.0\r\n\u001b[?2004l\r\u001b[?2004h> res_mask = tab_band['spatial_resolution'] < 1.0\r\n\u001b[?2004l\r\u001b[?2004h> tab_filt = tab_band[res_mask]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.50406, "o", "print(f\"Rows after resolution filter: {len(tab_filt)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.50411, "o", "# Group by member_ous_uid\r\n\u001b[?2004l\r"]
[165.504709, "o", "\u001b[?2004h> mous_groups = {}\r\n\u001b[?2004l\r\u001b[?2004h> for row in tab_filt:\r\n\u001b[?2004l\r\u001b[?2004h>     mous = str(row['member_ous_uid'])\r\n\u001b[?2004l\r\u001b[?2004h>     if mous not in mous_groups:\r\n\u001b[?2004l\r\u001b[?2004h>         mous_groups[mous] = {\r\n\u001b[?2004l\r\u001b[?2004h>             'member_ous_uid': mous,\r\n\u001b[?2004l\r\u001b[?2004h>             'project_code': str(row['proposal_id']),\r\n\u001b[?2004l\r\u001b[?2004h>             'alma_source_name': str(row['target_name']),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.504901, "o", "            'ra_deg': float(row['s_ra']),\r\n\u001b[?2004l\r\u001b[?2004h>             'dec_deg': float(row['s_dec']),\r\n\u001b[?2004l\r\u001b[?2004h>             'bands': set(),\r\n\u001b[?2004l\r\u001b[?2004h>             'resolutions': [],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.505117, "o", "            'qa2_status': str(row['qa2_passed'])\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     mous_groups[mous]['bands'].add(int(row['band_list']))\r\n\u001b[?2004l\r\u001b[?2004h>     mous_groups[mous]['resolutions'].append(float(row['spatial_resolution']))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> observations = []\r\n\u001b[?2004l\r\u001b[?2004h> for mous, data in mous_groups.items():\r\n\u001b[?2004l\r\u001b[?2004h>     observations.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.505984, "o", "        'member_ous_uid': data['member_ous_uid'],\r\n\u001b[?2004l\r\u001b[?2004h>         'project_code': data['project_code'],\r\n\u001b[?2004l\r\u001b[?2004h>         'alma_source_name': data['alma_source_name'],\r\n\u001b[?2004l\r\u001b[?2004h>         'ra_deg': data['ra_deg'],\r\n\u001b[?2004l\r\u001b[?2004h>         'dec_deg': data['dec_deg'],\r\n\u001b[?2004l\r\u001b[?2004h>         'band': sorted(data['bands']),\r\n\u001b[?2004l\r\u001b[?2004h>         'best_spatial_resolution_arcsec': min(data['resolutions']),\r\n\u001b[?2004l\r\u001b[?2004h>         'qa2_status': data['qa2_status']\r\n\u001b[?2004l\r\u001b[?2004h>     })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Sort by project_code for consistency\r\n\u001b[?2004l\r\u001b[?2004h> observations.sort(key=lambda x: x['member_ous_uid'])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Number of unique MOUS: {len(observations)}\")\r\n\u001b[?2004l\r"]
[165.506246, "o", "\u001b[?2004h> for obs in observations:\r\n\u001b[?2004l\r\u001b[?2004h>     print(obs)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Save intermediate for building final output\r\n\u001b[?2004l\r\u001b[?2004h> with open('/app/observations_temp.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     json.dump(observations, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r"]
[165.508402, "o", "\u001b[?2004hroot@f1b01bdb67bf:/app# "]
[166.522777, "i", "python3 /app/query.py\n"]
[166.523015, "o", "python3 /app/query.py\r\n\u001b[?2004l\r"]
