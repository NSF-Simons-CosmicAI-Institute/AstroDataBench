[236.417877, "i", "cat << 'PYEOF' > /app/final_query.py\nfrom astroquery.alma import Alma\nimport numpy as np\nimport json\n\nalma = Alma()\nra, dec = 85.96420833333333, -1.0480833333333335\nradius_arcsec = 30.0\n\nquery = f\"\"\"\nSELECT target_name, s_ra, s_dec, member_ous_uid, proposal_id, band_list,\n       spatial_resolution, qa2_passed, science_observation, data_rights\nFROM ivoa.obscore\nWHERE CONTAINS(POINT('ICRS', s_ra, s_dec), CIRCLE('ICRS', {ra}, {dec}, {radius_arcsec/3600.0})) = 1\nAND science_observation = 'T'\nAND data_rights = 'Public'\n\"\"\"\n\nresult = alma.query_tap(query)\ntab = result.to_table()\n\n# Filter by band 6 or 7\nband_mask = np.isin(tab['band_list'], ['6', '7'])\ntab_band = tab[band_mask]\n\n# Filter by spatial_resolution < 1.0\nres_mask = tab_band['spatial_resolution'] < 1.0\ntab_filt = tab_band[res_mask]\n\n# Group by member_ous_uid\nmous_groups = {}\nfor row in tab_filt:\n    mous = str(row['member_ous_uid'])\n    if mous not in mous_groups:\n        mous_groups[mous] = {\n            'member_ous_uid': mous,\n            'project_code': str(row['proposal_id']),\n            'alma_source_name': str(row['target_name']),\n            'ra_deg': float(row['s_ra']),\n            'dec_deg': float(row['s_dec']),\n            'bands': set(),\n            'resolutions': [],\n            'qa2_status': str(row['qa2_passed'])\n        }\n    mous_groups[mous]['bands'].add(int(row['band_list']))\n    mous_groups[mous]['resolutions'].append(float(row['spatial_resolution']))\n\nobservations = []\nfor mous, data in mous_groups.items():\n    observations.append({\n        'member_ous_uid': data['member_ous_uid'],\n        'project_code': data['project_code'],\n        'alma_source_name': data['alma_source_name'],\n        'ra_deg': data['ra_deg'],\n        'dec_deg': data['dec_deg'],\n        'band': sorted(data['bands']),\n        'best_spatial_resolution_arcsec': min(data['resolutions']),\n        'qa2_status': data['qa2_status']\n    })\n\nobservations.sort(key=lambda x: x['member_ous_uid'])\n\n# Compute summary statistics\nall_bands = set()\nfor obs in observations:\n    all_bands.update(obs['band'])\nall_bands = sorted(all_bands)\n\nall_res = [obs['best_spatial_resolution_arcsec'] for obs in observations]\nmin_res = min(all_res)\nmax_res = max(all_res)\n\nband6_count = sum(1 for obs in observations if 6 in obs['band'])\nband7_count = sum(1 for obs in observations if 7 in obs['band'])\n\nsummary = (\n    f\"A total of {len(observations)} unique ALMA Member Observation Unit Sets (MOUS) \"\n    f\"targeting HH 212 were found in Band 6 and/or Band 7 with spatial resolution better than 1 arcsecond. \"\n    f\"Of these, {band6_count} include Band 6 data and {band7_count} include Band 7 data. \"\n    f\"The best spatial resolution achieved ranges from {min_res:.4f} to {max_res:.4f} arcsec across the sample, \"\n    f\"reflecting a range of ALMA configurations from moderate to very high angular resolution. \"\n    f\"These public, science-grade observations span multiple ALMA projects and provide a rich dataset for studying \"\n    f\"the HH 212 protostellar outflow system at sub-arcsecond scales.\"\n)\n\noutput = {\n    'target_name': 'HH 212',\n    'resolved_ra_deg': ra,\n    'resolved_dec_deg': dec,\n    'search_radius_arcsec': radius_arcsec,\n    'band_filter': [6, 7],\n    'max_spatial_resolution_arcsec': 1.0,\n    'num_observations': len(observations),\n    'observations': observations,\n    'summary': summary\n}\n\nwith open('/app/output.json', 'w') as f:\n    json.dump(output, f, indent=2)\n\nprint(f\"Wrote output.json with {len(observations)} observations\")\nprint(json.dumps(output, indent=2)[:2000])\nPYEOF\n"]
