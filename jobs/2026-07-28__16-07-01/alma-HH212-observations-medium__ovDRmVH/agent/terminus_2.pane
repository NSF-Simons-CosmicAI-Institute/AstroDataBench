[?2004hroot@44351a46cfad:/app# cat << 'PYEOF' > /app/query.py
[?2004l[?2004h> from astroquery.alma import Alma
[?2004l[?2004h> import astropy.units as u
[?2004l[?2004h> from astropy.coordinates import SkyCoord
[?2004l[?2004h> import json
[?2004l[?2004h> from collections import defaultdict
[?2004l[?2004h> 
[?2004l[?2004h> coord = SkyCoord(ra=85.96420833333333, dec=-1.0480833333333335, unit='deg')
[?2004l[?2004h> alma = Alma()
[?2004l[?2004h> result = alma.query_region(coord, radius=30*u.arcsec)
[?2004l[?2004h> 
[?2004l[?2004h> print('Total rows:', len(result))
[?2004l[?2004h> 
[?2004l[?2004h> # Filter: public, science, band 6 or 7, spatial_resolution < 1 arcsec
[?2004l[?2004h> mask = (
[?2004l[?2004h>     (result['data_rights'] == 'Public') &
[?2004l[?2004h>     (result['science_observation'] == 'T') &
[?2004l[?2004h>     ((result['band_list'] == 6) | (result['band_list'] == 7)) &
[?2004l[?2004h>     (result['spatial_resolution'] < 1.0)
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> filtered = result[mask]
[?2004l[?2004h> print('Filtered rows:', len(filtered))
[?2004l[?2004h> 
[?2004l[?2004h> # Group by member_ous_uid
[?2004l[?2004h> groups = defaultdict(lambda: {'bands': set(), 'spatial_resolutions': [], 'proposal_id': None, 'target_name': None, 'obs_id': None})
[?2004l[?2004h> 
[?2004l[?2004h> for row in filtered:
[?2004l[?2004h>     mous = str(row['member_ous_uid'])
[?2004l[?2004h>     groups[mous]['bands'].add(int(row['band_list']))
[?2004l[?2004h>     groups[mous]['spatial_resolutions'].append(float(row['spatial_resolution']))
[?2004l[?2004h>     groups[mous]['proposal_id'] = str(row['proposal_id'])
[?2004l[?2004h>     groups[mous]['target_name'] = str(row['target_name'])
[?2004l[?2004h>     groups[mous]['obs_id'] = str(row['obs_id'])
[?2004l[?2004h> 
[?2004l[?2004h> observations = []
[?2004l[?2004h> for mous, data in groups.items():
[?2004l[?2004h>     observations.append({
[?2004l[?2004h>         'member_ous_uid': mous,
[?2004l[?2004h>         'project_code': data['proposal_id'],
[?2004l[?2004h>         'target_name': data['target_name'],
[?2004l[?2004h>         'bands': sorted(list(data['bands'])),
[?2004l[?2004h>         'spatial_resolution_arcsec': min(data['spatial_resolutions']),
[?2004l[?2004h>         'obs_id': data['obs_id']
[?2004l[?2004h>     })
[?2004l[?2004h> 
[?2004l[?2004h> observations.sort(key=lambda x: x['member_ous_uid'])
[?2004l[?2004h> 
[?2004l[?2004h> output = {
[?2004l[?2004h>     'target': 'HH 212',
[?2004l[?2004h>     'search_coordinates': {'ra_deg': 85.96420833333333, 'dec_deg': -1.0480833333333335},
[?2004l[?2004h>     'search_radius_arcsec': 30,
[?2004l[?2004h>     'filters': {
[?2004l[?2004h>         'data_rights': 'Public',
[?2004l[?2004h>         'science_observation': True,
[?2004l[?2004h>         'bands': [6, 7],
[?2004l[?2004h>         'spatial_resolution_max_arcsec': 1.0
[?2004l[?2004h>     },
[?2004l[?2004h>     'num_observations': len(observations),
[?2004l[?2004h>     'observations': observations
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/output.json', 'w') as f:
[?2004l[?2004h>     json.dump(output, f, indent=2)
