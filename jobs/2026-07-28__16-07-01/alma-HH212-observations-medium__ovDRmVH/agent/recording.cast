[91.015315, "i", "python3 << 'EOF'\nfrom astroquery.alma import Alma\nimport astropy.units as u\nfrom astropy.coordinates import SkyCoord\n\ncoord = SkyCoord(ra=85.96420833333333, dec=-1.0480833333333335, unit='deg')\nalma = Alma()\nresult = alma.query_region(coord, radius=30*u.arcsec)\n\nprint('band_list dtype:', result['band_list'].dtype)\nprint('science_observation dtype:', result['science_observation'].dtype)\nprint('data_rights dtype:', result['data_rights'].dtype)\nprint('spatial_resolution dtype:', result['spatial_resolution'].dtype)\n\nband_mask = (result['band_list'] == 6) | (result['band_list'] == 7)\nprint('band mask sum:', band_mask.sum())\n\nsci_mask = result['science_observation'] == 'T'\nprint('sci mask sum:', sci_mask.sum())\n\nrights_mask = result['data_rights'] == 'Public'\nprint('rights mask sum:', rights_mask.sum())\n\nres_mask = result['spatial_resolution'] < 1.0\nprint('res mask sum:', res_mask.sum())\nEOF\n"]
