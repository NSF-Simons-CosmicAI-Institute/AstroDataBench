[157.996538, "o", "alma = Alma()\r\n\u001b[?2004l\r"]
[157.996768, "o", "\u001b[?2004h> "]
[157.996813, "o", "result = alma.query_region(coord, radius=60*u.arcsec)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.997123, "o", "print('Total rows at 60arcsec:', len(result))\r\n\u001b[?2004l\r\u001b[?2004h> print('unique mous at 60arcsec:', len(set(result['member_ous_uid'])))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> result2 = alma.query_region(coord, radius=10*u.arcsec)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.997152, "o", "print('Total rows at 10arcsec:', len(result2))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[157.99725, "o", "print('unique mous at 10arcsec:', len(set(result2['member_ous_uid'])))\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
