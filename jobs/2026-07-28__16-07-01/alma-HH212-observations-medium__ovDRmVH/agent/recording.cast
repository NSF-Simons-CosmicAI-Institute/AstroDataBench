[157.995209, "i", "python3 << 'EOF'\nfrom astroquery.alma import Alma\nimport astropy.units as u\nfrom astropy.coordinates import SkyCoord\n\ncoord = SkyCoord(ra=85.96420833333333, dec=-1.0480833333333335, unit='deg')\nalma = Alma()\nresult = alma.query_region(coord, radius=60*u.arcsec)\nprint('Total rows at 60arcsec:', len(result))\nprint('unique mous at 60arcsec:', len(set(result['member_ous_uid'])))\n\nresult2 = alma.query_region(coord, radius=10*u.arcsec)\nprint('Total rows at 10arcsec:', len(result2))\nprint('unique mous at 10arcsec:', len(set(result2['member_ous_uid'])))\nEOF\n"]
