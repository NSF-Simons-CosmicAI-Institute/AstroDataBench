[68.180191, "i", "cat << 'PYEOF' > /app/query.py\nfrom astroquery.alma import Alma\nimport astropy.units as u\nfrom astropy.coordinates import SkyCoord\nimport json\nfrom collections import defaultdict\n\ncoord = SkyCoord(ra=85.96420833333333, dec=-1.0480833333333335, unit='deg')\nalma = Alma()\nresult = alma.query_region(coord, radius=30*u.arcsec)\n\nprint('Total rows:', len(result))\n\n# Filter: public, science, band 6 or 7, spatial_resolution < 1 arcsec\nmask = (\n    (result['data_rights'] == 'Public') &\n    (result['science_observation'] == 'T') &\n    ((result['band_list'] == 6) | (result['band_list'] == 7)) &\n    (result['spatial_resolution'] < 1.0)\n)\n\nfiltered = result[mask]\nprint('Filtered rows:', len(filtered))\n\n# Group by member_ous_uid\ngroups = defaultdict(lambda: {'bands': set(), 'spatial_resolutions': [], 'proposal_id': None, 'target_name': None, 'obs_id': None})\n\nfor row in filtered:\n    mous = str(row['member_ous_uid'])\n    groups[mous]['bands'].add(int(row['band_list']))\n    groups[mous]['spatial_resolutions'].append(float(row['spatial_resolution']))\n    groups[mous]['proposal_id'] = str(row['proposal_id'])\n    groups[mous]['target_name'] = str(row['target_name'])\n    groups[mous]['obs_id'] = str(row['obs_id'])\n\nobservations = []\nfor mous, data in groups.items():\n    observations.append({\n        'member_ous_uid': mous,\n        'project_code': data['proposal_id'],\n        'target_name': data['target_name'],\n        'bands': sorted(list(data['bands'])),\n        'spatial_resolution_arcsec': min(data['spatial_resolutions']),\n        'obs_id': data['obs_id']\n    })\n\nobservations.sort(key=lambda x: x['member_ous_uid'])\n\noutput = {\n    'target': 'HH 212',\n    'search_coordinates': {'ra_deg': 85.96420833333333, 'dec_deg': -1.0480833333333335},\n    'search_radius_arcsec': 30,\n    'filters': {\n        'data_rights': 'Public',\n        'science_observation': True,\n        'bands': [6, 7],\n        'spatial_resolution_max_arcsec': 1.0\n    },\n    'num_observations': len(observations),\n    'observations': observations\n}\n\nwith open('/app/output.json', 'w') as f:\n    json.dump(output, f, indent=2)\n\nprint('Wrote', len(observations), 'observations to /app/output.json')\nfor obs in observations:\n    print(obs)\nPYEOF\n"]
