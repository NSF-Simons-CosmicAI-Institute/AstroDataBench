[105.364083, "o", "\u001b[?2004h> alma = Alma()\r\n\u001b[?2004l\r\u001b[?2004h> result = alma.query_region(coord, radius=30*u.arcsec)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
