[169.131708, "i", "python3 -c \"\nimport json\nd = json.load(open('/app/output.json'))\nassert d['target_name'] == 'HH 212'\nassert isinstance(d['resolved_ra_deg'], float)\nassert isinstance(d['resolved_dec_deg'], float)\nassert isinstance(d['search_radius_arcsec'], float)\nassert d['band_filter'] == [6,7]\nassert d['max_spatial_resolution_arcsec'] == 1.0\nassert d['num_observations'] == len(d['observations'])\nuids = [o['member_ous_uid'] for o in d['observations']]\nassert len(uids) == len(set(uids)), 'duplicate uids!'\nfor o in d['observations']:\n    assert all(b in (6,7) for b in o['band'])\n    assert o['spatial_resolution_arcsec'] < 1.0\nprint('All validations passed!')\nprint('num_observations:', d['num_observations'])\n\"\n"]
