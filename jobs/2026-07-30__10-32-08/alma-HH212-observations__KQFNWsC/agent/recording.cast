[137.792937, "i", "cat << 'EOF' > /app/build_output.py\nimport json\nfrom astropy.table import Table\nimport numpy as np\n\nra = 85.96420833\ndec = -1.04808333\nradius = 30.0\n\nt = Table.read('/app/raw_results.ecsv')\n\n# Filter band 6/7 and spatial_resolution < 1.0\nmask = np.array([\n    (int(row['band_list']) in (6,7)) and (float(row['spatial_resolution']) < 1.0)\n    for row in t\n])\nfiltered = t[mask]\n\nprint('Filtered rows:', len(filtered))\nprint('Unique MOUS:', len(set(filtered['member_ous_uid'])))\n\nmous_groups = {}\nfor row in filtered:\n    uid = row['member_ous_uid']\n    if uid not in mous_groups:\n        mous_groups[uid] = {\n            'member_ous_uid': uid,\n            'project_code': str(row['proposal_id']),\n            'alma_source_name': str(row['target_name']),\n            'ra_deg': float(row['s_ra']),\n            'dec_deg': float(row['s_dec']),\n            'bands': set(),\n            'spatial_resolution_arcsec': float(row['spatial_resolution']),\n            'qa2_status': str(row['qa2_passed'])\n        }\n    mous_groups[uid]['bands'].add(int(row['band_list']))\n\nobservations = []\nfor uid, g in mous_groups.items():\n    observations.append({\n        'member_ous_uid': g['member_ous_uid'],\n        'project_code': g['project_code'],\n        'alma_source_name': g['alma_source_name'],\n        'ra_deg': g['ra_deg'],\n        'dec_deg': g['dec_deg'],\n        'band': sorted(g['bands']),\n        'spatial_resolution_arcsec': g['spatial_resolution_arcsec'],\n        'qa2_status': g['qa2_status']\n    })\n\n# sort by member_ous_uid for reproducibility\nobservations.sort(key=lambda x: x['member_ous_uid'])\n\nnum_obs = len(observations)\nbands_seen = sorted(set(b for o in observations for b in o['band']))\nres_values = [o['spatial_resolution_arcsec'] for o in observations]\nres_min = min(res_values) if res_values else None\nres_max = max(res_values) if res_values else None\n\nsummary = (\n    f\"A total of {num_obs} unique ALMA Member Observation Unit Sets (MOUS) targeting HH 212 \"\n    f\"were found in Band(s) {bands_seen} with spatial resolution under 1 arcsecond. \"\n    f\"Spatial resolutions range from {res_min:.3f} to {res_max:.3f} arcsec. \"\n    f\"These public science observations were identified via a {radius:.0f} arcsec positional search \"\n    f\"around the resolved coordinates of HH 212 (RA={ra:.5f}, Dec={dec:.5f}). \"\n    f\"The observations span multiple ALMA projects and include both Band 6 and Band 7 data where available.\"\n)\n\noutput = {\n    'target_name': 'HH 212',\n    'resolved_ra_deg': ra,\n    'resolved_dec_deg': dec,\n    'search_radius_arcsec': radius,\n    'band_filter': [6,7],\n    'max_spatial_resolution_arcsec': 1.0,\n    'num_observations': num_obs,\n    'observations': observations,\n    'summary': summary\n}\n\nwith open('/app/output.json', 'w') as f:\n    json.dump(output, f, indent=2)\n\nprint('Wrote output.json with', num_obs, 'observations')\nEOF\npython3 /app/build_output.py\n"]
