[151.812481, "o", "{\r\n  \"target_name\": \"HH 212\",\r\n  \"resolved_ra_deg\": 85.96420833,\r\n  \"resolved_dec_deg\": -1.04808333,\r\n  \"search_radius_arcsec\": 30.0,\r\n  \"band_filter\": [\r\n    6,\r\n    7\r\n  ],\r\n  \"max_spatial_resolution_arcsec\": 1.0,\r\n  \"num_observations\": 14,\r\n  \"observations\": [\r\n    {\r\n      \"member_ous_uid\": \"uid://A001/X1273/X1f9\",\r\n      \"project_code\": \"2017.1.00044.S\",\r\n      \"alma_source_name\": \"HH_212\",\r\n      \"ra_deg\": 85.96421125000545,\r\n      \"dec_deg\": -1.0481019444447288,\r\n      \"band\": [\r\n        7\r\n      ],\r\n      \"spatial_resolution_arcsec\": 0.0316734361630697,\r\n      \"qa2_status\": \"T\"\r\n    },\r\n    {\r\n      \"member_ous_uid\": \"uid://A001/X1284/X17b8\",\r\n      \"project_code\": \"2017.1.00712.S\",\r\n      \"alma_source_name\": \"HH_212\",\r\n      \"ra_deg\": 85.96421125001223,\r\n      \"dec_deg\": -1.0481019444444382,\r\n      \"band\": [\r\n        6\r\n      ],\r\n      \"spatial_resolution_arcsec\": 0.022781354834911657,\r\n      \"qa2_status\": \"T\"\r\n    },\r\n    {\r\n      \"member_ous_uid\": \"uid://A001/X1284/X17ba\",\r\n      \"project_code\": \"2017.1.00712.S\",\r\n      \"alma_source_name\": \"HH_212\",\r\n      \"ra_deg\": 85.96421125004338,\r\n      \"dec_deg\": -1.0481019444447166,\r\n      \"band\": [\r\n        6\r\n      ],\r\n      \"spatial_resolution_arcsec\": 0.1489361985467903,\r\n      \"qa2_status\": \"T\"\r\n    },\r\n    {\r\n      \"member_ous_uid\": \"uid://A001/X1473/Xbe6\",\r\n      \"project_code\": \"2019.1.00086.S\",\r\n      \"alma_source_name\": \"HH212M\",\r\n      \"ra_deg\": 85.96421250001843,\r\n      \"dec_deg\": -1.0481111111112291,\r\n      \"band\": [\r\n        7\r\n      ],\r\n      \"spatial_resolution_arcsec\": 0.8027864728676456,\r\n      \"qa2_status\": \"T\"\r\n    },\r\n    {\r\n      \"member_ous_uid\": \"uid://A001/X2de/X22\",\r\n      \"project_code\": \"2015.1.00037.S\",\r\n      \"alma_source_