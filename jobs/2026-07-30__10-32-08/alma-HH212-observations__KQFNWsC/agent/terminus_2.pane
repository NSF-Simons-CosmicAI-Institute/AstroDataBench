[?2004hroot@e45942edb307:/app# cat << 'EOF' > /app/build_output.py
[?2004l[?2004h> import json
[?2004l[?2004h> from astropy.table import Table
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> ra = 85.96420833
[?2004l[?2004h> dec = -1.04808333
[?2004l[?2004h> radius = 30.0
[?2004l[?2004h> 
[?2004l[?2004h> t = Table.read('/app/raw_results.ecsv')
[?2004l[?2004h> 
[?2004l[?2004h> # Filter band 6/7 and spatial_resolution < 1.0
[?2004l[?2004h> mask = np.array([
[?2004l[?2004h>     (int(row['band_list']) in (6,7)) and (float(row['spatial_resolution']) < 1.0)
[?2004l[?2004h>     for row in t
[?2004l[?2004h> ])
[?2004l[?2004h> filtered = t[mask]
[?2004l[?2004h> 
[?2004l[?2004h> print('Filtered rows:', len(filtered))
[?2004l[?2004h> print('Unique MOUS:', len(set(filtered['member_ous_uid'])))
[?2004l[?2004h> 
[?2004l[?2004h> mous_groups = {}
[?2004l[?2004h> for row in filtered:
[?2004l[?2004h>     uid = row['member_ous_uid']
[?2004l[?2004h>     if uid not in mous_groups:
[?2004l[?2004h>         mous_groups[uid] = {
[?2004l[?2004h>             'member_ous_uid': uid,
[?2004l[?2004h>             'project_code': str(row['proposal_id']),
[?2004l[?2004h>             'alma_source_name': str(row['target_name']),
[?2004l[?2004h>             'ra_deg': float(row['s_ra']),
[?2004l[?2004h>             'dec_deg': float(row['s_dec']),
[?2004l[?2004h>             'bands': set(),
[?2004l[?2004h>             'spatial_resolution_arcsec': float(row['spatial_resolution']),
[?2004l[?2004h>             'qa2_status': str(row['qa2_passed'])
[?2004l[?2004h>         }
[?2004l[?2004h>     mous_groups[uid]['bands'].add(int(row['band_list']))
[?2004l[?2004h> 
[?2004l[?2004h> observations = []
[?2004l[?2004h> for uid, g in mous_groups.items():
[?2004l[?2004h>     observations.append({
[?2004l[?2004h>         'member_ous_uid': g['member_ous_uid'],
[?2004l[?2004h>         'project_code': g['project_code'],
[?2004l[?2004h>         'alma_source_name': g['alma_source_name'],
[?2004l[?2004h>         'ra_deg': g['ra_deg'],
[?2004l[?2004h>         'dec_deg': g['dec_deg'],
[?2004l[?2004h>         'band': sorted(g['bands']),
[?2004l[?2004h>         'spatial_resolution_arcsec': g['spatial_resolution_arcsec'],
[?2004l[?2004h>         'qa2_status': g['qa2_status']
[?2004l[?2004h>     })
[?2004l[?2004h> 
[?2004l[?2004h> # sort by member_ous_uid for reproducibility
[?2004l[?2004h> observations.sort(key=lambda x: x['member_ous_uid'])
[?2004l[?2004h> 
[?2004l[?2004h> num_obs = len(observations)
[?2004l[?2004h> bands_seen = sorted(set(b for o in observations for b in o['band']))
[?2004l[?2004h> res_values = [o['spatial_resolution_arcsec'] for o in observations]
[?2004l[?2004h> res_min = min(res_values) if res_values else None
[?2004l[?2004h> res_max = max(res_values) if res_values else None
[?2004l[?2004h> 
[?2004l[?2004h> summary = (
[?2004l[?2004h>     f"A total of {num_obs} unique ALMA Member Observation Unit Sets (MOUS) targeting HH 212 "
[?2004l[?2004h>     f"were found in Band(s) {bands_seen} with spatial resolution under 1 arcsecond. "
[?2004l[?2004h>     f"Spatial resolutions range from {res_min:.3f} to {res_max:.3f} arcsec. "
[?2004l[?2004h>     f"These public science observations were identified via a {radius:.0f} arcsec positional search "
[?2004l[?2004h>     f"around the resolved coordinates of HH 212 (RA={ra:.5f}, Dec={dec:.5f}). "
[?2004l[?2004h>     f"The observations span multiple ALMA projects and include both Band 6 and Band 7 data where available."
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> output = {
[?2004l[?2004h>     'target_name': 'HH 212',
[?2004l[?2004h>     'resolved_ra_deg': ra,
[?2004l[?2004h>     'resolved_dec_deg': dec,
[?2004l[?2004h>     'search_radius_arcsec': radius,
[?2004l[?2004h>     'band_filter': [6,7],
[?2004l[?2004h>     'max_spatial_resolution_arcsec': 1.0,
[?2004l[?2004h>     'num_observations': num_obs,
[?2004l[?2004h>     'observations': observations,
[?2004l[?2004h>     'summary': summary
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/output.json', 'w') as f:
[?2004l[?2004h>     json.dump(output, f, indent=2)
[?2004l[?2004h> 
[?2004l[?2004h> print('Wrote output.json with', num_obs, 'observations')
[?2004l[?2004h> EOF
