[?2004l[?2004h> import pyvo
[?2004l[?2004h> from astropy.coordinates import SkyCoord
[?2004l[?2004h> import astropy.units as u
[?2004l[?2004h> 
[?2004l[?2004h> c = SkyCoord.from_name('HH 212')
[?2004l[?2004h> print('Coords:', c.ra.deg, c.dec.deg)
[?2004l[?2004h> 
[?2004l[?2004h> service = pyvo.dal.TAPService('https://almascience.eso.org/tap')
[?2004l[?2004h> 
[?2004l[?2004h> query = f"""
[?2004l[?2004h> SELECT member_ous_uid, proposal_id, band_list, spatial_resolution, target_name, s_ra, s_dec, science_observation, data_rights
[?2004l[?2004h> FROM ivoa.obscore
[?2004l[?2004h> WHERE CONTAINS(POINT('ICRS', s_ra, s_dec), CIRCLE('ICRS', {c.ra.deg}, {c.dec.deg}, 0.0167)) = 1
[?2004l[?2004h> AND science_observation = 'T'
[?2004l[?2004h> AND data_rights = 'Public'
[?2004l[?2004h> """
[?2004l[?2004h> 
[?2004l[?2004h> result = service.search(query)
[?2004l[?2004h> tbl = result.to_table()
[?2004l[?2004h> print('Total rows:', len(tbl))
[?2004l[?2004h> 
[?2004l[?2004h> # Filter band 6/7 and spatial_resolution<1
[?2004l[?2004h> mask = [(str(b) in ('6','7')) and (float(sr) < 1.0) for b, sr in zip(tbl['band_list'], tbl['spatial_resolution'])]
[?2004l[?2004h> tbl_f = tbl[mask]
[?2004l[?2004h> print('Filtered rows:', len(tbl_f))
[?2004l[?2004h> mous_set = set(str(x) for x in tbl_f['member_ous_uid'])
[?2004l[?2004h> print('Unique member_ous_uid:', len(mous_set))
[?2004l[?2004h> for m in sorted(mous_set):
[?2004l[?2004h>     print(m)
[?2004l[?2004h> EOF
