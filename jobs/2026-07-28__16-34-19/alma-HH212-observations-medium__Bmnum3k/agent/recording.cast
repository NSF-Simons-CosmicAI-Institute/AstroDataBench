[232.476844, "i", "cat << 'EOF' > /app/verify.py\nimport pyvo\nfrom astropy.coordinates import SkyCoord\nimport astropy.units as u\n\nc = SkyCoord.from_name('HH 212')\nprint('Coords:', c.ra.deg, c.dec.deg)\n\nservice = pyvo.dal.TAPService('https://almascience.eso.org/tap')\n\nquery = f\"\"\"\nSELECT member_ous_uid, proposal_id, band_list, spatial_resolution, target_name, s_ra, s_dec, science_observation, data_rights\nFROM ivoa.obscore\nWHERE CONTAINS(POINT('ICRS', s_ra, s_dec), CIRCLE('ICRS', {c.ra.deg}, {c.dec.deg}, 0.0167)) = 1\nAND science_observation = 'T'\nAND data_rights = 'Public'\n\"\"\"\n\nresult = service.search(query)\ntbl = result.to_table()\nprint('Total rows:', len(tbl))\n\n# Filter band 6/7 and spatial_resolution<1\nmask = [(str(b) in ('6','7')) and (float(sr) < 1.0) for b, sr in zip(tbl['band_list'], tbl['spatial_resolution'])]\ntbl_f = tbl[mask]\nprint('Filtered rows:', len(tbl_f))\nmous_set = set(str(x) for x in tbl_f['member_ous_uid'])\nprint('Unique member_ous_uid:', len(mous_set))\nfor m in sorted(mous_set):\n    print(m)\nEOF\npython3 /app/verify.py\n"]
