[117.367352, "i", "cat << 'EOF' > /app/query.py\nfrom astroquery.alma import Alma\nfrom astropy.coordinates import SkyCoord\nimport astropy.units as u\nimport json\nfrom collections import defaultdict\n\nc = SkyCoord(85.96420833, -1.04808333, unit='deg')\ntbl = Alma.query_region(c, radius=1*u.arcmin, public=True, science=True)\nprint('total rows:', len(tbl))\n\n# Filter band 6 or 7\nmask = [ (str(b) in ('6','7')) for b in tbl['band_list'] ]\ntbl6or7 = tbl[mask]\nprint('rows with band 6/7:', len(tbl6or7))\n\n# Further filter spatial_resolution < 1\nmask2 = [ (float(sr) < 1.0) for sr in tbl6or7['spatial_resolution'] ]\ntbl_final = tbl6or7[mask2]\nprint('rows with spatial_resolution<1:', len(tbl_final))\n\n# Group by member_ous_uid\ngroups = defaultdict(lambda: {'bands': set(), 'spatial_resolutions': set(), 'proposal_id': None, 'obs_id_examples': [], 'target_name': set(), 's_ra': None, 's_dec': None})\nfor row in tbl_final:\n    mous = str(row['member_ous_uid'])\n    g = groups[mous]\n    g['bands'].add(str(row['band_list']))\n    g['spatial_resolutions'].add(float(row['spatial_resolution']))\n    g['proposal_id'] = str(row['proposal_id'])\n    g['obs_id_examples'].append(str(row['obs_id']))\n    g['target_name'].add(str(row['target_name']))\n    g['s_ra'] = float(row['s_ra'])\n    g['s_dec'] = float(row['s_dec'])\n\nprint('unique member_ous_uid count:', len(groups))\nfor k,v in groups.items():\n    print(k, v['proposal_id'], sorted(v['bands']), sorted(v['spatial_resolutions']), v['target_name'])\nEOF\npython3 /app/query.py\n"]
