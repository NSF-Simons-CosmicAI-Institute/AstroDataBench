[87.760511, "i", "cat << 'EOF' > /app/explore2.py\nfrom astroquery.alma import Alma\nfrom astropy.coordinates import SkyCoord\nimport astropy.units as u\n\nc = SkyCoord(85.96420833, -1.04808333, unit='deg')\ntbl = Alma.query_region(c, radius=1*u.arcmin, public=True, science=True)\ncols = ['obs_id','member_ous_uid','proposal_id','band_list','spatial_resolution','data_rights','science_observation','s_ra','s_dec']\nfor col in cols:\n    print(col, tbl[col][:5])\nprint('---unique band_list---')\nprint(set(tbl['band_list']))\nprint('---unique data_rights---')\nprint(set(tbl['data_rights']))\nprint('---unique science_observation---')\nprint(set(tbl['science_observation']))\nEOF\npython3 /app/explore2.py\n"]
