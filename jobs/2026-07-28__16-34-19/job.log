Sending keys: ["cat << 'EOF' > /app/final.py\nfrom astroquery.alma import Alma\nfrom astropy.coordinates import SkyCoord\nimport astropy.units as u\nimport json\nfrom collections import defaultdict\n\n# Resolve HH 212 coordinates\nc = SkyCoord.from_name('HH 212')\nra_deg = c.ra.deg\ndec_deg = c.dec.deg\n\nsearch_radius_arcmin = 1.0\n\ntbl = Alma.query_region(c, radius=search_radius_arcmin*u.arcmin, public=True, science=True)\n\n# Filter for Band 6 or 7\nband_mask = [str(b) in ('6', '7') for b in tbl['band_list']]\ntbl_band = tbl[band_mask]\n\n# Filter for spatial_resolution < 1 arcsec\nres_mask = [float(sr) < 1.0 for sr in tbl_band['spatial_resolution']]\ntbl_final = tbl_band[res_mask]\n\n# Group by member_ous_uid\ngroups = defaultdict(lambda: {\n    'bands': set(),\n    'spatial_resolutions_arcsec': set(),\n    'proposal_id': None,\n    'target_names': set(),\n    's_ra_deg': None,\n    's_dec_deg': None,\n    'obs_ids': set()\n})\n\nfor row in tbl_final:\n    mous = str(row['member_ous_uid'])\n    g = groups[mous]\n    g['bands'].add(int(row['band_list']))\n    g['spatial_resolutions_arcsec'].add(float(row['spatial_resolution']))\n    g['proposal_id'] = str(row['proposal_id'])\n    g['target_names'].add(str(row['target_name']))\n    g['s_ra_deg'] = float(row['s_ra'])\n    g['s_dec_deg'] = float(row['s_dec'])\n    g['obs_ids'].add(str(row['obs_id']))\n\nobservations = []\nfor mous, g in sorted(groups.items()):\n    observations.append({\n        'member_ous_uid': mous,\n        'project_code': g['proposal_id'],\n        'bands': sorted(g['bands']),\n        'spatial_resolution_arcsec': min(g['spatial_resolutions_arcsec']),\n        'all_spatial_resolutions_arcsec': sorted(g['spatial_resolutions_arcsec']),\n        'target_names': sorted(g['target_names']),\n        's_ra_deg': g['s_ra_deg'],\n        's_dec_deg': g['s_dec_deg'],\n        'num_spectral_windows': len(g['obs_ids'])\n    })\n\noutput = {\n    'query_description': 'ALMA archive search for public, science observations near HH 212, Band 6 or 7, spatial_resolution < 1 arcsec',\n    'target': 'HH 212',\n    'resolved_coordinates': {\n        'ra_deg': ra_deg,\n        'dec_deg': dec_deg\n    },\n    'search_radius_arcmin': search_radius_arcmin,\n    'filters': {\n        'public': True,\n        'science': True,\n        'bands': [6, 7],\n        'spatial_resolution_arcsec_max': 1.0\n    },\n    'num_observations': len(observations),\n    'observations': observations\n}\n\nwith open('/app/output.json', 'w') as f:\n    json.dump(output, f, indent=2)\n\nprint('Wrote', len(observations), 'observations to /app/output.json')\nEOF\npython3 /app/final.py\n"] min_timeout_sec: 20.0 max_timeout_sec: 180.0
