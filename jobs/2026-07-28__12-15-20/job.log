ce_name\': entry[\'alma_source_name\'],\n        \'ra_deg\': entry[\'ra_deg\'],\n        \'dec_deg\': entry[\'dec_deg\'],\n        \'band\': sorted(entry[\'band_set\']),\n        \'best_spatial_resolution_arcsec\': entry[\'best_spatial_resolution_arcsec\'],\n        \'qa2_status\': entry[\'qa2_status\'],\n    })\n\nobservations.sort(key=lambda o: o[\'member_ous_uid\'])\n\nres_values = [o[\'best_spatial_resolution_arcsec\'] for o in observations]\nbands_present = sorted({b for o in observations for b in o[\'band\']})\n\nif res_values:\n    res_min = min(res_values)\n    res_max = max(res_values)\n    summary = (\n        f"A total of {len(observations)} unique ALMA Member OUS observations of HH 212 were found "\n        f"that are public, science-grade, in Band {\'/\'.join(map(str,bands_present))}, and have a "\n        f"spatial (synthesized beam) resolution under 1 arcsecond. "\n        f"The best spatial resolution among these observations ranges from {res_min:.3f} to {res_max:.3f} arcsec. "\n        f"These observations come from {len(set(o[\'project_code\'] for o in observations))} distinct ALMA project(s), "\n        f"providing high-resolution views of the HH 212 protostellar jet/outflow system."\n    )\nelse:\n    summary = "No qualifying observations were found for HH 212 with the specified band and resolution constraints."\n\noutput = {\n    \'target_name\': target_name,\n    \'resolved_ra_deg\': ra,\n    \'resolved_dec_deg\': dec,\n    \'search_radius_arcsec\': radius_arcsec,\n    \'band_filter\': [6, 7],\n    \'max_spatial_resolution_arcsec\': 1.0,\n    \'num_observations\': len(observations),\n    \'observations\': observations,\n    \'summary\': summary,\n}\n\nwith open(\'/app/output.json\', \'w\') as f:\n    json.dump(output, f, indent=2)\n\nprint(\'Wrote\', len(observations), \'observations to /app/output.json\')\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
