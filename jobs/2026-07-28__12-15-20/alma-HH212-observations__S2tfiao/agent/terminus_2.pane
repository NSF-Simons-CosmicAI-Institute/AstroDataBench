[?2004hroot@c6ffb4bc816b:/app# cat > /app/solve.py << 'EOF'
[?2004l[?2004h> import json
[?2004l[?2004h> from astroquery.alma import Alma
[?2004l[?2004h> import astropy.units as u
[?2004l[?2004h> from astropy.coordinates import SkyCoord
[?2004l[?2004h> 
[?2004l[?2004h> Alma.archive_url = 'https://almascience.eso.org'
[?2004l[?2004h> 
[?2004l[?2004h> target_name = "HH 212"
[?2004l[?2004h> c = SkyCoord.from_name(target_name)
[?2004l[?2004h> ra = float(c.ra.deg)
[?2004l[?2004h> dec = float(c.dec.deg)
[?2004l[?2004h> radius_arcsec = 30.0
[?2004l[?2004h> 
[?2004l[?2004h> result = Alma.query_region(c, radius=radius_arcsec*u.arcsec)
[?2004l[?2004h> 
[?2004l[?2004h> bands_allowed = {'6', '7'}
[?2004l[?2004h> 
[?2004l[?2004h> mous_data = {}
[?2004l[?2004h> 
[?2004l[?2004h> for row in result:
[?2004l[?2004h>     science_obs = str(row['science_observation']).strip()
[?2004l[?2004h>     data_rights = str(row['data_rights']).strip()
[?2004l[?2004h>     band = str(row['band_list']).strip()
[?2004l[?2004h>     try:
[?2004l[?2004h>         sres = float(row['spatial_resolution'])
[?2004l[?2004h>     except Exception:
[?2004l[?2004h>         continue
[?2004l[?2004h> 
[?2004l[?2004h>     if science_obs != 'T':
[?2004l[?2004h>         continue
[?2004l[?2004h>     if data_rights != 'Public':
[?2004l[?2004h>         continue
[?2004l[?2004h>     if band not in bands_allowed:
[?2004l[?2004h>         continue
[?2004l[?2004h>     if not (sres < 1.0):
[?2004l[?2004h>         continue
[?2004l[?2004h> 
[?2004l[?2004h>     mous = str(row['member_ous_uid']).strip()
[?2004l[?2004h>     proposal_id = str(row['proposal_id']).strip()
[?2004l[?2004h>     src_name = str(row['target_name']).strip()
[?2004l[?2004h>     s_ra = float(row['s_ra'])
[?2004l[?2004h>     s_dec = float(row['s_dec'])
[?2004l[?2004h>     qa2 = str(row['qa2_passed']).strip()
[?2004l[?2004h> 
[?2004l[?2004h>     if mous not in mous_data:
[?2004l[?2004h>         mous_data[mous] = {
[?2004l[?2004h>             'member_ous_uid': mous,
[?2004l[?2004h>             'project_code': proposal_id,
[?2004l[?2004h>             'alma_source_name': src_name,
[?2004l[?2004h>             'ra_deg': s_ra,
[?2004l[?2004h>             'dec_deg': s_dec,
[?2004l[?2004h>             'band_set': set(),
[?2004l[?2004h>             'best_spatial_resolution_arcsec': sres,
[?2004l[?2004h>             'qa2_status': qa2,
[?2004l[?2004h>         }
[?2004l[?2004h>     entry = mous_data[mous]
[?2004l[?2004h>     entry['band_set'].add(int(band))
[?2004l[?2004h>     if sres < entry['best_spatial_resolution_arcsec']:
[?2004l[?2004h>         entry['best_spatial_resolution_arcsec'] = sres
[?2004l[?2004h> 
[?2004l[?2004h> observations = []
[?2004l[?2004h> for mous, entry in mous_data.items():
[?2004l[?2004h>     observations.append({
[?2004l[?2004h>         'member_ous_uid': entry['member_ous_uid'],
[?2004l[?2004h>         'project_code': entry['project_code'],
[?2004l[?2004h>         'alma_source_name': entry['alma_source_name'],
[?2004l[?2004h>         'ra_deg': entry['ra_deg'],
[?2004l[?2004h>         'dec_deg': entry['dec_deg'],
[?2004l[?2004h>         'band': sorted(entry['band_set']),
[?2004l[?2004h>         'best_spatial_resolution_arcsec': entry['best_spatial_resolution_arcsec'],
[?2004l[?2004h>         'qa2_status': entry['qa2_status'],
[?2004l[?2004h>     })
[?2004l[?2004h> 
[?2004l[?2004h> observations.sort(key=lambda o: o['member_ous_uid'])
[?2004l[?2004h> 
[?2004l[?2004h> res_values = [o['best_spatial_resolution_arcsec'] for o in observations]
[?2004l[?2004h> bands_present = sorted({b for o in observations for b in o['band']})
[?2004l[?2004h> 
[?2004l[?2004h> if res_values:
[?2004l[?2004h>     res_min = min(res_values)
[?2004l[?2004h>     res_max = max(res_values)
[?2004l[?2004h>     summary = (
[?2004l[?2004h>         f"A total of {len(observations)} unique ALMA Member OUS observations of HH 212 were found "
[?2004l[?2004h>         f"that are public, science-grade, in Band {'/'.join(map(str,bands_present))}, and have a "
[?2004l[?2004h>         f"spatial (synthesized beam) resolution under 1 arcsecond. "
[?2004l[?2004h>         f"The best spatial resolution among these observations ranges from {res_min:.3f} to {res_max:.3f} arcsec. "
[?2004l[?2004h>         f"These observations come from {len(set(o['project_code'] for o in observations))} distinct ALMA project(s), "
[?2004l[?2004h>         f"providing high-resolution views of the HH 212 protostellar jet/outflow system."
[?2004l[?2004h>     )
[?2004l[?2004h> else:
[?2004l[?2004h>     summary = "No qualifying observations were found for HH 212 with the specified band and resolution constraints."
[?2004l[?2004h> 
[?2004l[?2004h> output = {
[?2004l[?2004h>     'target_name': target_name,
[?2004l[?2004h>     'resolved_ra_deg': ra,
[?2004l[?2004h>     'resolved_dec_deg': dec,
[?2004l[?2004h>     'search_radius_arcsec': radius_arcsec,
[?2004l[?2004h>     'band_filter': [6, 7],
[?2004l[?2004h>     'max_spatial_resolution_arcsec': 1.0,
[?2004l[?2004h>     'num_observations': len(observations),
[?2004l[?2004h>     'observations': observations,
[?2004l[?2004h>     'summary': summary,
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/output.json', 'w') as f:
[?2004l[?2004h>     json.dump(output, f, indent=2)
[?2004l[?2004h> 
[?2004l[?2004h> print('Wrote', len(observations), 'observations to /app/output.json')
