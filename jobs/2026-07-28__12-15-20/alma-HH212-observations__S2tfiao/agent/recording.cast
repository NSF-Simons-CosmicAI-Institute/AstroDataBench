[145.132797, "o", "            'member_ous_uid': mous,\r\n\u001b[?2004l\r\u001b[?2004h>             'project_code': proposal_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[145.132937, "o", "            'alma_source_name': src_name,\r\n\u001b[?2004l\r\u001b[?2004h>             'ra_deg': s_ra,\r\n\u001b[?2004l\r\u001b[?2004h>             'dec_deg': s_dec,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[145.13301, "o", "            'band_set': set(),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[145.133137, "o", "            'best_spatial_resolution_arcsec': sres,\r\n\u001b[?2004l\r\u001b[?2004h>             'qa2_status': qa2,\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     entry = mous_data[mous]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[145.133243, "o", "    entry['band_set'].add(int(band))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[145.133271, "o", "    if sres < entry['best_spatial_resolution_arcsec']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[145.13344, "o", "        entry['best_spatial_resolution_arcsec'] = sres\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[145.133589, "o", "observations = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[145.133625, "o", "for mous, entry in mous_data.items():\r\n\u001b[?2004l\r\u001b[?2004h>     observations.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[145.133797, "o", "        'member_ous_uid': entry['member_ous_uid'],\r\n\u001b[?2004l\r\u001b[?2004h>         'project_code': entry['project_code'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[145.133906, "o", "        'alma_source_name': entry['alma_source_name'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[145.134008, "o", "        'ra_deg': entry['ra_deg'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
