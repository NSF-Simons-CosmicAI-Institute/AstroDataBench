[145.13418, "o", "        'band': sorted(entry['band_set']),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[145.13421, "o", "        'best_spatial_resolution_arcsec': entry['best_spatial_resolution_arcsec'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[145.134313, "o", "        'qa2_status': entry['qa2_status'],\r\n\u001b[?2004l\r\u001b[?2004h>     })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[145.1344, "o", "observations.sort(key=lambda o: o['member_ous_uid'])\r\n"]
[145.134493, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[145.134565, "o", "res_values = [o['best_spatial_resolution_arcsec'] for o in observations]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[145.134664, "o", "bands_present = sorted({b for o in observations for b in o['band']})\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> if res_values:\r\n\u001b[?2004l\r"]
[145.134752, "o", "\u001b[?2004h>     res_min = min(res_values)\r\n\u001b[?2004l\r\u001b[?2004h>     res_max = max(res_values)\r\n\u001b[?2004l\r"]
[145.134834, "o", "\u001b[?2004h>     summary = (\r\n\u001b[?2004l\r\u001b[?2004h> "]
[145.134943, "o", "        f\"A total of {len(observations)} unique ALMA Member OUS observations of HH 212 were found \"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[145.13504, "o", "        f\"that are public, science-grade, in Band {'/'.join(map(str,bands_present))}, and have a \"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[145.13516, "o", "        f\"spatial (synthesized beam) resolution under 1 arcsecond. \"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[145.13526, "o", "        f\"The best spatial resolution among these observations ranges from {res_min:.3f} to {res_max:.3f} arcsec. \"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[145.135442, "o", "        f\"These observations come from {len(set(o['project_code'] for o in observations))} distinct ALMA project(s), \"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[145.135571, "o", "        f\"providing high-resolution views of the HH 212 protostellar jet/outflow system.\"\r\n\u001b[?2004l\r\u001b[?2004h>     )\r\n\u001b[?2004l\r\u001b[?2004h> else:"]
[145.135581, "o", "\r\n\u001b[?2004l\r"]
[145.135643, "o", "\u001b[?2004h> "]
[145.135747, "o", "    summary = \"No qualifying observations were found for HH 212 with the specified band and resolution constraints.\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[145.135833, "o", "> output = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[145.135865, "o", "    'target_name': target_name,\r\n\u001b[?2004l\r\u001b[?2004h>     'resolved_ra_deg': ra,\r\n\u001b[?2004l\r"]
[145.135922, "o", "\u001b[?2004h> "]
[145.135943, "o", "    'resolved_dec_deg': dec,\r\n\u001b[?2004l\r"]
[145.136048, "o", "\u001b[?2004h> "]
[145.136195, "o", "    'search_radius_arcsec': radius_arcsec,\r\n\u001b[?2004l\r\u001b[?2004h>     'band_filter': [6, 7],\r\n\u001b[?2004l\r\u001b[?2004h>     'max_spatial_resolution_arcsec': 1.0,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[145.136252, "o", "    'num_observations': len(observations),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[145.136356, "o", "    'observations': observations,\r\n\u001b[?2004l\r\u001b[?2004h>     'summary': summary,\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[145.136432, "o", "with open('/app/output.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     json.dump(output, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[145.136476, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
