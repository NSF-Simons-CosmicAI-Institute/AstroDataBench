[101.188778, "i", "python3 << 'EOF'\nfrom astroquery.alma import Alma\nimport astropy.units as u\nfrom astropy.coordinates import SkyCoord\nimport numpy as np\nAlma.archive_url = 'https://almascience.eso.org'\nc = SkyCoord(85.96420833, -1.04808333, unit='deg')\nresult = Alma.query_region(c, radius=30*u.arcsec)\nprint(set(result['band_list'].data.tolist()))\nprint(set(result['science_observation'].data.tolist()))\nprint(set(result['data_rights'].data.tolist()))\nprint(set(result['qa2_passed'].data.tolist()))\nmous_bands = {}\nfor row in result:\n    m = row['member_ous_uid']\n    mous_bands.setdefault(m, set()).add(row['band_list'])\nfor k,v in mous_bands.items():\n    print(k, v)\nEOF\n"]
