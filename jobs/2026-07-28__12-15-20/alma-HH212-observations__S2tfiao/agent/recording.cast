[145.129906, "i", "cat > /app/solve.py << 'EOF'\nimport json\nfrom astroquery.alma import Alma\nimport astropy.units as u\nfrom astropy.coordinates import SkyCoord\n\nAlma.archive_url = 'https://almascience.eso.org'\n\ntarget_name = \"HH 212\"\nc = SkyCoord.from_name(target_name)\nra = float(c.ra.deg)\ndec = float(c.dec.deg)\nradius_arcsec = 30.0\n\nresult = Alma.query_region(c, radius=radius_arcsec*u.arcsec)\n\nbands_allowed = {'6', '7'}\n\nmous_data = {}\n\nfor row in result:\n    science_obs = str(row['science_observation']).strip()\n    data_rights = str(row['data_rights']).strip()\n    band = str(row['band_list']).strip()\n    try:\n        sres = float(row['spatial_resolution'])\n    except Exception:\n        continue\n\n    if science_obs != 'T':\n        continue\n    if data_rights != 'Public':\n        continue\n    if band not in bands_allowed:\n        continue\n    if not (sres < 1.0):\n        continue\n\n    mous = str(row['member_ous_uid']).strip()\n    proposal_id = str(row['proposal_id']).strip()\n    src_name = str(row['target_name']).strip()\n    s_ra = float(row['s_ra'])\n    s_dec = float(row['s_dec'])\n    qa2 = str(row['qa2_passed']).strip()\n\n    if mous not in mous_data:\n        mous_data[mous] = {\n            'member_ous_uid': mous,\n            'project_code': proposal_id,\n            'alma_source_name': src_name,\n            'ra_deg': s_ra,\n            'dec_deg': s_dec,\n            'band_set': set(),\n            'best_spatial_resolution_arcsec': sres,\n            'qa2_status': qa2,\n        }\n    entry = mous_data[mous]\n    entry['band_set'].add(int(band))\n    if sres < entry['best_spatial_resolution_arcsec']:\n        entry['best_spatial_resolution_arcsec'] = sres\n\nobservations = []\nfor mous, entry in mous_data.items():\n    observations.append({\n        'member_ous_uid': entry['member_ous_uid'],\n        'project_code': entry['project_code'],\n        'alma_source_name': entry['alma_source_name'],\n        'ra_deg': entry['ra_deg'],\n        'dec_deg': entry['dec_deg'],\n        'band': sorted(entry['band_set']),\n        'best_spatial_resolution_arcsec': entry['best_spatial_resolution_arcsec'],\n        'qa2_status': entry['qa2_status'],\n    })\n\nobservations.sort(key=lambda o: o['member_ous_uid'])\n\nres_values = [o['best_spatial_resolution_arcsec'] for o in observations]\nbands_present = sorted({b for o in observations for b in o['band']})\n\nif res_values:\n    res_min = min(res_values)\n    res_max = max(res_values)\n    summary = (\n        f\"A total of {len(observations)} unique ALMA Member OUS observations of HH 212 were found \"\n        f\"that are public, science-grade, in Band {'/'.join(map(str,bands_present))}, and have a \"\n        f\"spatial (synthesized beam) resolution under 1 arcsecond. \"\n        f\"The best spatial resolution among these observations ranges from {res_min:.3f} to {res_max:.3f} arcsec. \"\n        f\"These observations come from {len(set(o['project_code'] for o in observations))} distinct ALMA project(s), \"\n        f\"providing high-resolution views of the HH 212 protostellar jet/outflow system.\"\n    )\nelse:\n    summary = \"No qualifying observations were found for HH 212 with the specified band and resolution constraints.\"\n\noutput = {\n    'target_name': target_name,\n    'resolved_ra_deg': ra,\n    'resolved_dec_deg': dec,\n    'search_radius_arcsec': radius_arcsec,\n    'band_filter': [6, 7],\n    'max_spatial_resolution_arcsec': 1.0,\n    'num_observations': len(observations),\n    'observations': observations,\n    'summary': summary,\n}\n\nwith open('/app/output.json', 'w') as f:\n    json.dump(output, f, indent=2)\n\nprint('Wrote', len(observations), 'observations to /app/output.json')\nEOF\n"]
