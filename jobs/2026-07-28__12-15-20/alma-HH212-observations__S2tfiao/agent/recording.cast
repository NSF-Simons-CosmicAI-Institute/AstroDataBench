[197.551623, "i", "python3 -c \"\nimport json\nd = json.load(open('/app/output.json'))\nassert d['target_name'] == 'HH 212'\nassert isinstance(d['resolved_ra_deg'], float)\nassert isinstance(d['resolved_dec_deg'], float)\nassert d['band_filter'] == [6,7]\nassert d['max_spatial_resolution_arcsec'] == 1.0\nassert d['num_observations'] == len(d['observations'])\nmous_set = set()\nfor o in d['observations']:\n    assert o['member_ous_uid'] not in mous_set\n    mous_set.add(o['member_ous_uid'])\n    assert all(b in (6,7) for b in o['band'])\n    assert o['best_spatial_resolution_arcsec'] < 1.0\nprint('All checks passed. num_observations =', d['num_observations'])\n\"\n"]
