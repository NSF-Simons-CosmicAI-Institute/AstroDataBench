[137.871823, "i", "cat > /app/explore4.py << 'EOF'\nfrom astroquery.alma import Alma\nfrom astropy.coordinates import SkyCoord\nimport astropy.units as u\n\nc = SkyCoord(85.96420833, -1.04808333, unit='deg')\nalma = Alma()\nfor r in [10, 20, 30, 60, 120]:\n    result = alma.query_region(c, radius=r*u.arcsec, public=True, science=True)\n    print(r, len(result), len(set(result['member_ous_uid'])))\nEOF\npython3 /app/explore4.py\n"]
