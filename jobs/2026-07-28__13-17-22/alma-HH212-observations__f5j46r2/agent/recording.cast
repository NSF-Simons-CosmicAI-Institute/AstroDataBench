[176.677699, "i", "cat > /app/explore5.py << 'EOF'\nfrom astroquery.alma import Alma\nfrom astropy.coordinates import SkyCoord\nimport astropy.units as u\nimport numpy as np\n\nc = SkyCoord(85.96420833, -1.04808333, unit='deg')\nalma = Alma()\nresult = alma.query_region(c, radius=30*u.arcsec, public=True, science=True)\n\n# check per-MOUS consistency\nimport collections\nmous_groups = collections.defaultdict(list)\nfor row in result:\n    mous_groups[row['member_ous_uid']].append(row)\n\nfor mous, rows in list(mous_groups.items())[:5]:\n    bands = set(r['band_list'] for r in rows)\n    qa2 = set(r['qa2_passed'] for r in rows)\n    targets = set(r['target_name'] for r in rows)\n    print(mous, bands, qa2, targets, len(rows))\nEOF\npython3 /app/explore5.py\n"]
