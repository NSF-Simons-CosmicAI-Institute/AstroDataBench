[81.846344, "i", "cat > /app/explore2.py << 'EOF'\nfrom astroquery.alma import Alma\nfrom astropy.coordinates import SkyCoord\nimport astropy.units as u\n\nc = SkyCoord(85.96420833, -1.04808333, unit='deg')\nalma = Alma()\nresult = alma.query_region(c, radius=30*u.arcsec, public=True, science=True)\ncols = ['target_name','s_ra','s_dec','band_list','spatial_resolution','member_ous_uid','proposal_id','qa2_passed','science_observation','data_rights']\nfor col in cols:\n    print(col, '->', result[col][:5])\nprint('unique target_name:', set(result['target_name']))\nprint('unique science_observation:', set(result['science_observation']))\nprint('unique data_rights:', set(result['data_rights']))\nEOF\npython3 /app/explore2.py\n"]
