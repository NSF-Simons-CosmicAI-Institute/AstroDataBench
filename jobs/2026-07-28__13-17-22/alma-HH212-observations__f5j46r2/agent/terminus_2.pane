[?2004hroot@0923ce879be9:/app# cat > /app/solve.py << 'EOF'
[?2004l[?2004h> from astroquery.alma import Alma
[?2004l[?2004h> from astropy.coordinates import SkyCoord
[?2004l[?2004h> import astropy.units as u
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import json
[?2004l[?2004h> import collections
[?2004l[?2004h> 
[?2004l[?2004h> # Resolve HH 212 coordinates
[?2004l[?2004h> ra_deg = 85.96420833
[?2004l[?2004h> dec_deg = -1.04808333
[?2004l[?2004h> radius_arcsec = 30.0
[?2004l[?2004h> 
[?2004l[?2004h> c = SkyCoord(ra_deg, dec_deg, unit='deg')
[?2004l[?2004h> alma = Alma()
[?2004l[?2004h> result = alma.query_region(c, radius=radius_arcsec*u.arcsec, public=True, science=True)
[?2004l[?2004h> 
[?2004l[?2004h> print('Total rows from query:', len(result))
[?2004l[?2004h> 
[?2004l[?2004h> # Filter: band in [6,7] and spatial_resolution < 1.0
[?2004l[?2004h> mask = []
[?2004l[?2004h> for row in result:
[?2004l[?2004h>     band = int(row['band_list'])
[?2004l[?2004h>     sr = float(row['spatial_resolution'])
[?2004l[?2004h>     mask.append(band in (6,7) and sr < 1.0)
[?2004l[?2004h> mask = np.array(mask)
[?2004l[?2004h> filtered = result[mask]
[?2004l[?2004h> print('Filtered rows (band 6/7, spatial_resolution<1):', len(filtered))
[?2004l[?2004h> 
[?2004l[?2004h> # Group by member_ous_uid
[?2004l[?2004h> groups = collections.defaultdict(list)
[?2004l[?2004h> for row in filtered:
[?2004l[?2004h>     groups[str(row['member_ous_uid'])].append(row)
[?2004l[?2004h> 
[?2004l[?2004h> print('Unique MOUS after filter:', len(groups))
[?2004l[?2004h> 
[?2004l[?2004h> observations = []
[?2004l[?2004h> for mous, rows in groups.items():
[?2004l[?2004h>     bands = sorted(set(int(r['band_list']) for r in rows))
[?2004l[?2004h>     best_sr = min(float(r['spatial_resolution']) for r in rows)
[?2004l[?2004h>     proposal_id = str(rows[0]['proposal_id'])
[?2004l[?2004h>     target_name = str(rows[0]['target_name'])
[?2004l[?2004h>     ra = float(rows[0]['s_ra'])
[?2004l[?2004h>     dec = float(rows[0]['s_dec'])
[?2004l[?2004h>     qa2_vals = set(str(r['qa2_passed']) for r in rows)
[?2004l[?2004h>     # take the qa2 status - should be consistent, but just in case take 'T' if any T
[?2004l[?2004h>     qa2_status = 'T' if 'T' in qa2_vals else ('F' if 'F' in qa2_vals else list(qa2_vals)[0])
[?2004l[?2004h>     observations.append({
[?2004l[?2004h>         'member_ous_uid': mous,
[?2004l[?2004h>         'project_code': proposal_id,
[?2004l[?2004h>         'alma_source_name': target_name,
[?2004l[?2004h>         'ra_deg': ra,
[?2004l[?2004h>         'dec_deg': dec,
[?2004l[?2004h>         'band': bands,
[?2004l[?2004h>         'best_spatial_resolution_arcsec': best_sr,
[?2004l[?2004h>         'qa2_status': qa2_status
[?2004l[?2004h>     })
[?2004l[?2004h> 
[?2004l[?2004h> # sort observations by member_ous_uid for determinism
[?2004l[?2004h> observations.sort(key=lambda x: x['member_ous_uid'])
[?2004l[?2004h> 
[?2004l[?2004h> bands_all = sorted(set(b for o in observations for b in o['band']))
[?2004l[?2004h> sr_values = [o['best_spatial_resolution_arcsec'] for o in observations]
[?2004l[?2004h> sr_min = min(sr_values) if sr_values else None
[?2004l[?2004h> sr_max = max(sr_values) if sr_values else None
[?2004l[?2004h> 
[?2004l[?2004h> summary = (
[?2004l[?2004h>     f"A total of {len(observations)} unique ALMA Member Observation Unit Sets (MOUS) targeting HH 212 "
[?2004l[?2004h>     f"were found in Band {'/'.join(str(b) for b in bands_all)} with spatial resolution under 1 arcsecond. "
[?2004l[?2004h>     f"The synthesized beam sizes (spatial_resolution) for these observations range from "
[?2004l[?2004h>     f"{sr_min:.4f} to {sr_max:.4f} arcsec, providing high-resolution views of the HH 212 protostellar jet system. "
[?2004l[?2004h>     f"These observations come from multiple ALMA proposals and cover the continuum and line emission in the "
[?2004l[?2004h>     f"submillimeter regime typical of Band 6/7 science."
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> output = {
[?2004l[?2004h>     'target_name': 'HH 212',
[?2004l[?2004h>     'resolved_ra_deg': ra_deg,
[?2004l[?2004h>     'resolved_dec_deg': dec_deg,
[?2004l[?2004h>     'search_radius_arcsec': radius_arcsec,
[?2004l[?2004h>     'band_filter': [6, 7],
[?2004l[?2004h>     'max_spatial_resolution_arcsec': 1.0,
[?2004l[?2004h>     'num_observations': len(observations),
[?2004l[?2004h>     'observations': observations,
[?2004l[?2004h>     'summary': summary
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/output.json', 'w') as f:
[?2004l[?2004h>     json.dump(output, f, indent=2)
[?2004l[?2004h> 
[?2004l[?2004h> print('Wrote output.json with', len(observations), 'observations')
[?2004l[?2004h> EOF
