Sending keys: ['cat > /app/solve.py << \'EOF\'\nfrom astroquery.alma import Alma\nfrom astropy.coordinates import SkyCoord\nimport astropy.units as u\nimport numpy as np\nimport json\nimport collections\n\n# Resolve HH 212 coordinates\nra_deg = 85.96420833\ndec_deg = -1.04808333\nradius_arcsec = 30.0\n\nc = SkyCoord(ra_deg, dec_deg, unit=\'deg\')\nalma = Alma()\nresult = alma.query_region(c, radius=radius_arcsec*u.arcsec, public=True, science=True)\n\nprint(\'Total rows from query:\', len(result))\n\n# Filter: band in [6,7] and spatial_resolution < 1.0\nmask = []\nfor row in result:\n    band = int(row[\'band_list\'])\n    sr = float(row[\'spatial_resolution\'])\n    mask.append(band in (6,7) and sr < 1.0)\nmask = np.array(mask)\nfiltered = result[mask]\nprint(\'Filtered rows (band 6/7, spatial_resolution<1):\', len(filtered))\n\n# Group by member_ous_uid\ngroups = collections.defaultdict(list)\nfor row in filtered:\n    groups[str(row[\'member_ous_uid\'])].append(row)\n\nprint(\'Unique MOUS after filter:\', len(groups))\n\nobservations = []\nfor mous, rows in groups.items():\n    bands = sorted(set(int(r[\'band_list\']) for r in rows))\n    best_sr = min(float(r[\'spatial_resolution\']) for r in rows)\n    proposal_id = str(rows[0][\'proposal_id\'])\n    target_name = str(rows[0][\'target_name\'])\n    ra = float(rows[0][\'s_ra\'])\n    dec = float(rows[0][\'s_dec\'])\n    qa2_vals = set(str(r[\'qa2_passed\']) for r in rows)\n    # take the qa2 status - should be consistent, but just in case take \'T\' if any T\n    qa2_status = \'T\' if \'T\' in qa2_vals else (\'F\' if \'F\' in qa2_vals else list(qa2_vals)[0])\n    observations.append({\n        \'member_ous_uid\': mous,\n        \'project_code\': proposal_id,\n        \'alma_source_name\': target_name,\n        \'ra_deg\': ra,\n        \'dec_deg\': dec,\n        \'band\': bands,\n        \'best_spatial_resolution_arcsec\': best_sr,\n        \'qa2_status\': qa2_status\n    })\n\n# sort observations by member_ous_uid for determinism\nobservations.sort(key=lambda x: x[\'member_ous_uid\'])\n\nbands_all = sorted(set(b for o in observations for b in o[\'band\']))\nsr_values = [o[\'best_spatial_resolution_arcsec\'] for o in observations]\nsr_min = min(sr_values) if sr_values else None\nsr_max = max(sr_values) if sr_values else None\n\nsummary = (\n    f"A total of {len(observations)} unique ALMA Member Observation Unit Sets (MOUS) targeting HH 212 "\n    f"were found in Band {\'/\'.join(str(b) for b in bands_all)} with spatial resolution under 1 arcsecond. "\n    f"The synthesized beam sizes (spatial_resolution) for these observations range from "\n    f"{sr_min:.4f} to {sr_max:.4f} arcsec, providing high-resolution views of the HH 212 protostellar jet system. "\n    f"These observations come from multiple ALMA proposals and cover the continuum and line emission in the "\n    f"submillimeter regime typical of Band 6/7 science."\n)\n\noutput = {\n    \'target_name\': \'HH 212\',\n    \'resolved_ra_deg\': ra_deg,\n    \'resolved_dec_deg\': dec_deg,\n    \'search_radius_arcsec\': radius_arcsec,\n    \'band_filter\': [6, 7],\n    \'max_spatial_resolution_arcsec\': 1.0,\n    \'num_observations\': len(observations),\n    \'observations\': observations,\n    \'summary\': summary\n}\n\nwith open(\'/app/output.json\', \'w\') as f:\n    json.dump(output, f, indent=2)\n\nprint(\'Wrote output.json with\', len(observations), \'observations\')\nEOF\npython3 /app/solve.py\n'] min_timeout_sec: 30.0 max_timeout_sec: 180.0
