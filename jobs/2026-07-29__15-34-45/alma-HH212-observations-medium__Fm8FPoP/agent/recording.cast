[125.934906, "o", "groups = defaultdict(list)\r\n\u001b[?2004l\r\u001b[?2004h> for row in result:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.934986, "o", "    groups[row['member_ous_uid']].append(row)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.935376, "o", "observations = []\r\n\u001b[?2004l\r\u001b[?2004h> for uid, rows in groups.items():\r\n\u001b[?2004l\r\u001b[?2004h>     rights = set(str(r['data_rights']) for r in rows)\r\n\u001b[?2004l\r\u001b[?2004h>     sci = set(str(r['science_observation']) for r in rows)\r\n\u001b[?2004l\r\u001b[?2004h>     if rights != {'Public'}:\r\n\u001b[?2004l\r\u001b[?2004h>         continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.935394, "o", "    if sci != {'T'}:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.935624, "o", "        continue\r\n\u001b[?2004l\r\u001b[?2004h>     bands = set(str(r['band_list']) for r in rows)\r\n\u001b[?2004l\r\u001b[?2004h>     if len(bands) != 1:\r\n\u001b[?2004l\r\u001b[?2004h>         print('WARNING multiple bands for', uid, bands)"]
[125.93569, "o", "\r\n\u001b[?2004l\r"]
[125.935961, "o", "\u001b[?2004h>     band = list(bands)[0]\r\n\u001b[?2004l\r\u001b[?2004h>     if band not in ('6','7'):\r\n\u001b[?2004l\r\u001b[?2004h>         continue\r\n\u001b[?2004l\r\u001b[?2004h>     resolutions = [float(r['spatial_resolution']) for r in rows]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.935996, "o", "    max_res = max(resolutions)\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.936014, "o", "> "]
[125.936267, "o", "    min_res = min(resolutions)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.936406, "o", "    avg_res = sum(resolutions)/len(resolutions)\r\n\u001b[?2004l\r\u001b[?2004h>     if max_res >= 1.0:\r\n\u001b[?2004l\r\u001b[?2004h>         continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.936743, "o", "    proposals = set(str(r['proposal_id']) for r in rows)\r\n\u001b[?2004l\r\u001b[?2004h>     targets = set(str(r['target_name']) for r in rows)\r\n\u001b[?2004l\r\u001b[?2004h>     obs = {\r\n\u001b[?2004l\r\u001b[?2004h>         'member_ous_uid': uid,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.937071, "o", "        'project_code': list(proposals)[0] if len(proposals)==1 else list(proposals),\r\n\u001b[?2004l\r\u001b[?2004h>         'band': band,\r\n\u001b[?2004l\r\u001b[?2004h>         'spatial_resolution_arcsec': round(avg_res, 4),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.937362, "o", "        'spatial_resolution_min': round(min_res,4),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.937373, "o", "        'spatial_resolution_max': round(max_res,4),\r\n\u001b[?2004l\r\u001b[?2004h>         'target_name': list(targets)[0] if len(targets)==1 else list(targets),\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.937411, "o", "    observations.append(obs)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
