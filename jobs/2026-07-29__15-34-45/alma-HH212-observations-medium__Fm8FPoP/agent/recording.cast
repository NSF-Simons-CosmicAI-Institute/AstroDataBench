[79.80156, "i", "cat << 'EOF' > /app/explore3.py\nfrom astroquery.alma import Alma\nimport numpy as np\nfrom collections import defaultdict\n\nAlma.archive_url = 'https://almascience.org'\nresult = Alma.query_object('HH 212')\n\ngroups = defaultdict(list)\nfor row in result:\n    groups[row['member_ous_uid']].append(row)\n\nfor uid, rows in groups.items():\n    bands = set(r['band_list'] for r in rows)\n    resolutions = set(round(float(r['spatial_resolution']),4) for r in rows)\n    proposals = set(r['proposal_id'] for r in rows)\n    targets = set(r['target_name'] for r in rows)\n    rights = set(r['data_rights'] for r in rows)\n    sci = set(r['science_observation'] for r in rows)\n    print(uid, 'bands=',bands,'res=',resolutions,'proposal=',proposals,'target=',targets,'rights=',rights,'sci=',sci)\nEOF\npython3 /app/explore3.py\n"]
