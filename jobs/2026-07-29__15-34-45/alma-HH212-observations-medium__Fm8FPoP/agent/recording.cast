[125.934129, "i", "cat << 'EOF' > /app/final.py\nfrom astroquery.alma import Alma\nimport numpy as np\nfrom collections import defaultdict\nimport json\n\nAlma.archive_url = 'https://almascience.org'\nresult = Alma.query_object('HH 212')\n\ngroups = defaultdict(list)\nfor row in result:\n    groups[row['member_ous_uid']].append(row)\n\nobservations = []\nfor uid, rows in groups.items():\n    rights = set(str(r['data_rights']) for r in rows)\n    sci = set(str(r['science_observation']) for r in rows)\n    if rights != {'Public'}:\n        continue\n    if sci != {'T'}:\n        continue\n    bands = set(str(r['band_list']) for r in rows)\n    if len(bands) != 1:\n        print('WARNING multiple bands for', uid, bands)\n    band = list(bands)[0]\n    if band not in ('6','7'):\n        continue\n    resolutions = [float(r['spatial_resolution']) for r in rows]\n    max_res = max(resolutions)\n    min_res = min(resolutions)\n    avg_res = sum(resolutions)/len(resolutions)\n    if max_res >= 1.0:\n        continue\n    proposals = set(str(r['proposal_id']) for r in rows)\n    targets = set(str(r['target_name']) for r in rows)\n    obs = {\n        'member_ous_uid': uid,\n        'project_code': list(proposals)[0] if len(proposals)==1 else list(proposals),\n        'band': band,\n        'spatial_resolution_arcsec': round(avg_res, 4),\n        'spatial_resolution_min': round(min_res,4),\n        'spatial_resolution_max': round(max_res,4),\n        'target_name': list(targets)[0] if len(targets)==1 else list(targets),\n    }\n    observations.append(obs)\n\nobservations.sort(key=lambda o: o['member_ous_uid'])\n\noutput = {\n    'target': 'HH 212',\n    'query_criteria': {\n        'public': True,\n        'science_observation': True,\n        'bands': ['6','7'],\n        'spatial_resolution_arcsec_max': 1.0,\n        'note': 'spatial_resolution is the ObsCore synthesized beam size column, one row per member_ous_uid (MOUS)'\n    },\n    'num_observations': len(observations),\n    'observations': observations\n}\n\nwith open('/app/output.json','w') as f:\n    json.dump(output, f, indent=2)\n\nprint('Total MOUS groups:', len(groups))\nprint('Matching observations:', len(observations))\nfor o in observations:\n    print(o)\nEOF\npython3 /app/final.py\n"]
[125.934409, "o", "cat << 'EOF' > /app/final.py\r\n\u001b[?2004l\r"]
