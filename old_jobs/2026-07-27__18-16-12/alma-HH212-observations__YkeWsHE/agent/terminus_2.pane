[?2004hroot@444bbc37f763:/app# cat << 'PYEOF' > /app/query.py
[?2004l[?2004h> from astroquery.alma import Alma
[?2004l[?2004h> from astropy.coordinates import SkyCoord
[?2004l[?2004h> import astropy.units as u
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> ra_deg = 85.96420833
[?2004l[?2004h> dec_deg = -1.04808333
[?2004l[?2004h> radius_arcsec = 30.0
[?2004l[?2004h> 
[?2004l[?2004h> c = SkyCoord(ra_deg, dec_deg, unit='deg')
[?2004l[?2004h> result = Alma.query_region(c, radius=radius_arcsec*u.arcsec, public=True, science=True)
[?2004l[?2004h> 
[?2004l[?2004h> print('Total rows:', len(result))
[?2004l[?2004h> 
[?2004l[?2004h> # Convert to pandas for easier grouping
[?2004l[?2004h> df = result.to_pandas()
[?2004l[?2004h> print(df.columns.tolist())
[?2004l[?2004h> 
[?2004l[?2004h> # Filter band 6 or 7
[?2004l[?2004h> df['band_list_int'] = df['band_list'].astype(int)
[?2004l[?2004h> mask_band = df['band_list_int'].isin([6,7])
[?2004l[?2004h> df_band = df[mask_band].copy()
[?2004l[?2004h> print('After band filter:', len(df_band))
[?2004l[?2004h> 
[?2004l[?2004h> # Filter spatial_resolution < 1.0
[?2004l[?2004h> mask_res = df_band['spatial_resolution'] < 1.0
[?2004l[?2004h> df_filtered = df_band[mask_res].copy()
[?2004l[?2004h> print('After spatial_resolution filter:', len(df_filtered))
[?2004l[?2004h> 
[?2004l[?2004h> print(df_filtered[['member_ous_uid','band_list_int','spatial_resolution','proposal_id','target_name','qa2_passed','s_ra','s_dec']])
[?2004l[?2004h> 
[?2004l[?2004h> # Group by member_ous_uid
[?2004l[?2004h> grouped = df_filtered.groupby('member_ous_uid')
[?2004l[?2004h> 
[?2004l[?2004h> observations = []
[?2004l[?2004h> for mous, group in grouped:
[?2004l[?2004h>     best_idx = group['spatial_resolution'].idxmin()
[?2004l[?2004h>     best_row = group.loc[best_idx]
[?2004l[?2004h>     bands = sorted(group['band_list_int'].unique().tolist())
[?2004l[?2004h>     band_val = bands[0] if len(bands)==1 else bands
[?2004l[?2004h>     obs = {
[?2004l[?2004h>         'member_ous_uid': mous,
[?2004l[?2004h>         'project_code': str(best_row['proposal_id']),
[?2004l[?2004h>         'alma_source_name': str(best_row['target_name']),
[?2004l[?2004h>         'ra_hms': float(best_row['s_ra']),
[?2004l[?2004h>         'dec_dms': float(best_row['s_dec']),
[?2004l[?2004h>         'band': int(band_val) if not isinstance(band_val, list) else band_val,
[?2004l[?2004h>         'best_spatial_resolution_arcsec': float(group['spatial_resolution'].min()),
[?2004l[?2004h>         'qa2_status': str(best_row['qa2_passed'])
[?2004l[?2004h>     }
[?2004l[?2004h>     observations.append(obs)
[?2004l[?2004h> 
[?2004l[?2004h> print(json.dumps(observations, indent=2))
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/observations_debug.json','w') as f:
[?2004l[?2004h>     json.dump(observations, f, indent=2)
