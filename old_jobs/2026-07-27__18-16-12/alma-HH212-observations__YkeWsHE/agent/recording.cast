[72.79878, "i", "python3 << 'EOF'\nfrom astroquery.alma import Alma\nfrom astropy.coordinates import SkyCoord\nimport astropy.units as u\n\nc = SkyCoord(85.96420833, -1.04808333, unit='deg')\nresult = Alma.query_region(c, radius=10*u.arcsec, public=True, science=True)\nfor col in ['target_name','band_list','spatial_resolution','member_ous_uid','proposal_id','qa2_passed','s_ra','s_dec']:\n    print(col, result[col][:5])\nEOF\n"]
