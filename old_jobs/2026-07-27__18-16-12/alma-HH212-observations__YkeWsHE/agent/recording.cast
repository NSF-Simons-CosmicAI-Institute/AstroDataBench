333,\r\n    \"dec_dms\": -1.0481,\r\n    \"band\": 7,\r\n    \"best_spatial_resolution_arcsec\": 0.4624913139122095,\r\n    \"qa2_status\": \"T\"\r\n  },\r\n  {\r\n    \"member_ous_uid\": \"uid://A002/X6ac013/X11\",\r\n    \"project_code\": \"2012.1.00997.S\",\r\n    \"alma_source_name\": \"HH212\",\r\n    \"ra_hms\": 85.96420833333333,\r\n    \"dec_dms\": -1.0481,\r\n    \"band\": 7,\r\n    \"best_spatial_resolution_arcsec\": 0.2933729566553391,\r\n    \"qa2_status\": \"T\"\r\n  },\r\n  {\r\n    \"member_ous_uid\": \"uid://A002/X7b15a9/X5a\",\r\n    \"project_code\": \"2012.1.00122.S\",\r\n    \"alma_source_name\": \"HH212\",\r\n    \"ra_hms\": 85.96439055186667,\r\n    \"dec_dms\": -1.048172537602811,\r"]
