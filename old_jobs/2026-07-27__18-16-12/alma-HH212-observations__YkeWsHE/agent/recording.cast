[92.669926, "i", "python3 << 'EOF'\nfrom astroquery.alma import Alma\nfrom astropy.coordinates import SkyCoord\nimport astropy.units as u\n\nc = SkyCoord(85.96420833, -1.04808333, unit='deg')\nresult = Alma.query_region(c, radius=30*u.arcsec, public=True, science=True)\nprint(len(result))\nimport numpy as np\nprint(set(result['band_list']))\nprint(set(result['qa2_passed']))\nprint(len(set(result['member_ous_uid'])))\nEOF\n"]
