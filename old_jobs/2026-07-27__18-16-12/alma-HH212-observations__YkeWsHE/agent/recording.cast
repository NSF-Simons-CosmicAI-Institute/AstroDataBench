[120.66477, "i", "cat << 'PYEOF' > /app/query.py\nfrom astroquery.alma import Alma\nfrom astropy.coordinates import SkyCoord\nimport astropy.units as u\nimport numpy as np\nimport json\n\nra_deg = 85.96420833\ndec_deg = -1.04808333\nradius_arcsec = 30.0\n\nc = SkyCoord(ra_deg, dec_deg, unit='deg')\nresult = Alma.query_region(c, radius=radius_arcsec*u.arcsec, public=True, science=True)\n\nprint('Total rows:', len(result))\n\n# Convert to pandas for easier grouping\ndf = result.to_pandas()\nprint(df.columns.tolist())\n\n# Filter band 6 or 7\ndf['band_list_int'] = df['band_list'].astype(int)\nmask_band = df['band_list_int'].isin([6,7])\ndf_band = df[mask_band].copy()\nprint('After band filter:', len(df_band))\n\n# Filter spatial_resolution < 1.0\nmask_res = df_band['spatial_resolution'] < 1.0\ndf_filtered = df_band[mask_res].copy()\nprint('After spatial_resolution filter:', len(df_filtered))\n\nprint(df_filtered[['member_ous_uid','band_list_int','spatial_resolution','proposal_id','target_name','qa2_passed','s_ra','s_dec']])\n\n# Group by member_ous_uid\ngrouped = df_filtered.groupby('member_ous_uid')\n\nobservations = []\nfor mous, group in grouped:\n    best_idx = group['spatial_resolution'].idxmin()\n    best_row = group.loc[best_idx]\n    bands = sorted(group['band_list_int'].unique().tolist())\n    band_val = bands[0] if len(bands)==1 else bands\n    obs = {\n        'member_ous_uid': mous,\n        'project_code': str(best_row['proposal_id']),\n        'alma_source_name': str(best_row['target_name']),\n        'ra_hms': float(best_row['s_ra']),\n        'dec_dms': float(best_row['s_dec']),\n        'band': int(band_val) if not isinstance(band_val, list) else band_val,\n        'best_spatial_resolution_arcsec': float(group['spatial_resolution'].min()),\n        'qa2_status': str(best_row['qa2_passed'])\n    }\n    observations.append(obs)\n\nprint(json.dumps(observations, indent=2))\n\nwith open('/app/observations_debug.json','w') as f:\n    json.dump(observations, f, indent=2)\nPYEOF\n"]
[120.66525, "o", "cat << 'PYEOF' > /app/query.py\r\n\u001b[?2004l\r\u001b[?2004h> from astroquery.alma import Alma\r\n\u001b[?2004l\r\u001b[?2004h> from astropy.coordinates import SkyCoord\r\n\u001b[?2004l\r"]
