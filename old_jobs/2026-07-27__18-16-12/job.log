Sending keys: ['cat << \'PYEOF\' > /app/final_query.py\nfrom astroquery.alma import Alma\nfrom astropy.coordinates import SkyCoord\nimport astropy.units as u\nimport json\n\nra_deg = 85.96420833\ndec_deg = -1.04808333\nradius_arcsec = 30.0\n\nc = SkyCoord(ra_deg, dec_deg, unit=\'deg\')\nresult = Alma.query_region(c, radius=radius_arcsec*u.arcsec, public=True, science=True)\n\ndf = result.to_pandas()\ndf[\'band_list_int\'] = df[\'band_list\'].astype(int)\n\nmask_band = df[\'band_list_int\'].isin([6,7])\ndf_band = df[mask_band].copy()\n\nmask_res = df_band[\'spatial_resolution\'] < 1.0\ndf_filtered = df_band[mask_res].copy()\n\ngrouped = df_filtered.groupby(\'member_ous_uid\')\n\nobservations = []\nfor mous, group in grouped:\n    best_idx = group[\'spatial_resolution\'].idxmin()\n    best_row = group.loc[best_idx]\n    bands = sorted(group[\'band_list_int\'].unique().tolist())\n    band_val = bands[0] if len(bands) == 1 else bands\n    obs = {\n        \'member_ous_uid\': str(mous),\n        \'project_code\': str(best_row[\'proposal_id\']),\n        \'alma_source_name\': str(best_row[\'target_name\']),\n        \'ra_hms\': float(best_row[\'s_ra\']),\n        \'dec_dms\': float(best_row[\'s_dec\']),\n        \'band\': int(band_val) if not isinstance(band_val, list) else band_val,\n        \'best_spatial_resolution_arcsec\': float(group[\'spatial_resolution\'].min()),\n        \'qa2_status\': str(best_row[\'qa2_passed\'])\n    }\n    observations.append(obs)\n\n# Sort by project_code then member_ous_uid for consistent ordering\nobservations.sort(key=lambda x: (x[\'project_code\'], x[\'member_ous_uid\']))\n\nnum_obs = len(observations)\nbands_present = sorted(set(o[\'band\'] for o in observations if isinstance(o[\'band\'], int)))\nres_values = [o[\'best_spatial_resolution_arcsec\'] for o in observations]\nmin_res = min(res_values)\nmax_res = max(res_values)\n\nbands_str = \' and \'.join(str(b) for b in bands_present)\n\nsummary = (\n    f"A positional search around HH 212 (RA={ra_deg:.5f}, Dec={dec_deg:.5f}) with a {radius_arcsec:.0f} arcsec radius "\n    f"identified {num_obs} unique ALMA science observations (MOUS) in Band {bands_str} with spatial resolution "\n    f"better than 1 arcsec. The best spatial resolution achieved is {min_res:.4f} arcsec, while the coarsest in this "\n    f"filtered sample is {max_res:.4f} arcsec. These observations span multiple ALMA projects and cover both continuum "\n    f"and line observations of the HH 212 protostellar jet/outflow system, with source names recorded in the archive "\n    f"variably as HH_212, HH212, HH212M, and HH212MMS."\n)\n\noutput = {\n    \'target_name\': \'HH 212\',\n    \'resolved_ra_deg\': ra_deg,\n    \'resolved_dec_deg\': dec_deg,\n    \'search_radius_arcsec\': radius_arcsec,\n    \'band_filter\': [6, 7],\n    \'max_spatial_resolution_arcsec\': 1.0,\n    \'num_observations\': num_obs,\n    \'observations\': observations,\n    \'summary\': summary\n}\n\nwith open(\'/app/output.json\', \'w\') as f:\n    json.dump(output, f, indent=2)\n\nprint(\'Wrote output.json with\', num_obs, \'observations\')\nprint(json.dumps(output, indent=2))\nPYEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
